<Project Sdk="Aspire.AppHost.Sdk/13.5.3">
  <!--
    Aspire AppHost: one `aspire run` boots Postgres -> lobby migrations -> public lobby -> sim server,
    with dashboard commands to launch Godot clients, approve a server's device code, and deploy the
    lobby/server to Railway. Local-dev only; nothing here ships (see .dockerignore/.railwayignore).
    Run with `aspire run` (or `aspire start` in the background) from the repo root - never `dotnet run`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StellarAllegiance.AppHost</RootNamespace>
    <!-- Shared with scripts/godot-bin.ps1 and the "Godot: set executable path" VS Code task, so the
         godot.executablePath secret and the dashboard's "Save to user secret" land in one file. -->
    <UserSecretsId>stellarallegiance</UserSecretsId>
    <!-- Custom commands / parameters / pipeline steps use APIs Aspire still marks experimental. -->
    <NoWarn>$(NoWarn);ASPIREINTERACTION001;ASPIREPIPELINES001;ASPIREPUBLISHERS001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire project resources (generate Projects.PublicLobby / Projects.SimServer). The Godot client
         is NOT referenced: it is a Godot.NET.Sdk project launched by the Godot binary (executable resource). -->
    <ProjectReference Include="../public-lobby/PublicLobby.csproj" />
    <ProjectReference Include="../server/SimServer.csproj" />
  </ItemGroup>
</Project>
