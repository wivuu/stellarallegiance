<Project>
  <!-- Central Package Management (CPM): every NuGet version for the repo lives HERE, and the
       csprojs carry bare <PackageReference Include="..." /> with no Version attribute. One package,
       one version, one edit — SIPSorcery and Microsoft.IdentityModel.JsonWebTokens are each
       consumed by two projects that MUST stay in lockstep (the server and the Godot client share
       the WebRTC SDP handshake; the server verifies the ES256 join tokens the lobby mints).

       CentralPackageTransitivePinningEnabled lets a <PackageVersion> below also raise a TRANSITIVE
       dependency without any project taking a direct reference on it. Use that to lift a
       transitive off a vulnerable version (an AngleSharp pin did this until
       AspNet.Security.OpenId.Steam 11.0.0 raised its own floor to 1.10.1); drop such a pin once the
       package that drags it in ships a fix of its own. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Aspire AppHost (apphost/): local orchestration of postgres + lobby + sim server. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
  </ItemGroup>

  <!-- Public lobby (public-lobby/, public-lobby-data/): identity, Orleans, EF Core, telemetry.
       The lobby targets net11.0, but its EF Core stack stays on the 10.0 line ON PURPOSE: the
       Npgsql provider has no GA 11.x build (11.0.0-rc.3 pins EF Core to exactly rc.3), and
       EFCore.NamingConventions caps EF Core below 11. The two ASP.NET packages that sit ON EF Core
       (DataProtection.EntityFrameworkCore, Identity.EntityFrameworkCore) depend on EF Core 11 from
       11.0.0 up, so they stay 10.0.x with it; they run fine on the 11 shared framework. Move these
       five (plus dotnet-ef in dotnet-tools.json) to 11 together, once Npgsql ships a GA 11.x. -->
  <ItemGroup>
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="11.0.0" />
    <PackageVersion Include="AspNet.Security.OpenId.Steam" Version="11.0.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.AdoNet" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <!-- Shared by the sim server AND the Godot client: these two versions must move together. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="SIPSorcery" Version="10.0.17" />
  </ItemGroup>

  <!-- Server-only content pipeline (server/Content): YAML loading + the AOT static generator. -->
  <ItemGroup>
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Game launcher (launcher/): Avalonia shell + Velopack updates. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.6" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- NOT here on purpose: Microsoft.CodeAnalysis.CSharp / .Analyzers. tools/wire-gen pins Roslyn
       4.x deliberately (a source generator loads into the compiler process, so it targets the
       OLDEST Roslyn it must run on). With transitive pinning ON, a central entry would apply that
       floor to EVERY project, downgrading what Microsoft.EntityFrameworkCore.Design (Roslyn >=
       5.0.0) and Microsoft.Orleans.Server (Analyzers >= 3.11.0) resolve, which is NU1109. The pin
       therefore stays local to WireGen.csproj as a VersionOverride. -->

  <!-- Test suites (tests/, factions/tests/). GodotSharp is absent on purpose: Godot.NET.Sdk
       defines it IMPLICITLY for the client, and CPM forbids a central version for an implicit
       reference (NU1009), so InterpTest carries it as a VersionOverride instead. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
