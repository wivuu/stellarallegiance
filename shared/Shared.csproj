<Project Sdk="Microsoft.NET.Sdk">
  <!-- Canonical home of the deterministic flight model. Referenced (not copied)
       by the SpacetimeDB module, the Godot client, and the FlightModelTest via
       <ProjectReference>. Each consumer's own runtime compiles this same source,
       so the wasm-server and mono-client math stays bit-identical. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Folder is shared/ but the namespace is StellarAllegiance.Shared (used by
         every consumer); match RootNamespace so analyzers don't flag a mismatch. -->
    <RootNamespace>StellarAllegiance.Shared</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- CS9057 = "analyzer references a NEWER compiler than the running one", i.e. the wire
         generator got silently DISABLED because the SDK is too old. Left as a warning it is
         near-invisible: this project still reports "Build succeeded" with zero generated files, and
         the damage surfaces far away as ~30 bogus CS0117s ("ShipRecord does not contain a
         definition for Size") in server/Net/Protocol.cs. Promote it to an error so an
         under-SDK'd build fails HERE, naming the real cause. See tools/wire-gen/WireGen.csproj. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS9057</WarningsAsErrors>
    <!-- No RID here on purpose: this is portable managed IL. The consuming
         project (e.g. the wasi-wasm module) supplies the RID and recompiles. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- The wire-format source generator (tools/wire-gen, docs/adr/0003): an ANALYZER reference, so it
         runs inside the compiler and ships nothing at runtime. Generated partials are written under
         obj/ (EmitCompilerGeneratedFiles) for inspection. -->
    <ProjectReference Include="../tools/wire-gen/WireGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Net/WebRtcSdp.cs is SIPSorcery-dependent WebRTC source that the client and server compile
         in via <Compile Include Link>. This project stays dependency-free, so exclude that file
         (dependency-free shared/Net sources like Wire.cs DO compile here). -->
    <Compile Remove="Net/WebRtcSdp.cs" />
  </ItemGroup>
</Project>
