# `railway up` tars the repo root for BOTH Railway services (public-lobby/Dockerfile and
# server/Dockerfile build from the root context). Mirror .dockerignore so the upload stays small:
# each Dockerfile copies only shared/, its own project dirs, and (sim-server) the GLB asset dirs.
.git
.github
.vscode
.opencode
.copilot
.claude
**/bin
**/obj
**/.godot
graphify-out
build
pick-assets
client/*
!client/assets
client/assets/*
!client/assets/bases
!client/assets/asteroids
!client/assets/ships
docs
tests
# Exclude tools/ but keep the wire-format source generator: shared/Shared.csproj references it as an
# analyzer, and without it the sim-server does not compile (mirrors .dockerignore — see
# server/Dockerfile). The last matching line wins, so bin/obj are excluded again after the re-include.
tools/*
!tools/wire-gen
tools/wire-gen/bin
tools/wire-gen/obj
module
scripts
deploy
.stdb-data
.env
# Aspire AppHost is local-dev only
apphost
aspire.config.json
.aspire
