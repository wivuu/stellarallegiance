<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Game Launcher: a small themed Avalonia app that is the Velopack main executable on every OS.
       It owns the install/update hooks, the update UX and crash recovery, then starts the Godot game
       as a child process. The game itself takes no Velopack dependency. See launcher/README.md.

       Published as NativeAOT on Windows and macOS (instant start for Velopack's fast-exit hooks, no
       JIT entitlement needed on macOS, ~1/3 the size). On Linux, scripts/package-clients.ps1 publishes
       self-contained JIT instead (-p:PublishAot=false): there are no hooks there, and an AOT binary
       built on a current runner would raise the glibc floor above what the game itself needs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StellarLauncher</AssemblyName>
    <RootNamespace>StellarAllegiance.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- LibraryImport source-generated P/Invoke (Platform/MacInterop.cs, WinInterop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- A trim/AOT warning is a latent runtime crash in the published binary — fail the build instead. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050</WarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <!-- Only used by the launcher-shot flag: renders the window off-screen with the real Skia renderer, so
         screenshots work on display-less CI runners (and on a Mac whose display is asleep). -->
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/StellarLauncher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated, committed assets: static font instances (tools/font-instancer) and launcher art
         (tools/launcher-art). Embedded as avares:// resources so the AOT binary carries them. -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
