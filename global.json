{
  // .NET 10.0.4xx SDKs ship a Razor source-generator regression: it slices tag-helper attribute
  // expressions (<partial name="…" model="…" />) and markup inside @if blocks at the wrong source
  // offsets, so public-lobby's Razor Pages fail to compile with nonsense C# errors pointing at
  // valid markup. 10.0.3xx generates the same pages correctly — pin the band until 4xx is fixed.
  "sdk": {
    "version": "10.0.302",
    "rollForward": "latestPatch"
  }
}
