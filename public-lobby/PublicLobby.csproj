<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Public lobby / signaling box. A tiny stateless ASP.NET service that player-run game
       servers register themselves with (name + session id) and that clients query to browse and
       join. It ALSO relays the WebRTC SDP offer/answer handshake (see Signaling.cs) so a NAT'd
       game server is reachable without port-forwarding — the actual game DataChannel is P2P
       (or TURN-relayed via the coturn sidecar), never through this process.

       Was originally a .NET-10 file-based app (single PublicLobby.cs with a #:sdk header); file
       based apps can't span multiple .cs files, so it is a normal net10.0 csproj now — same
       toolchain/Docker pattern as server/ and shared/.

       Identity/persistence/ranking (.PLAN/LobbyRankingService.md): the lobby is its own identity
       issuer (ADR-0001) over Postgres + co-hosted Orleans (ADR-0002). The EF model lives in the
       sibling public-lobby-data/ project; the HTTP contracts every peer compiles live in
       shared/Lobby/. The Dockerfile copies all three directories (build context = repo root). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PublicLobby</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../public-lobby-data/PublicLobby.Data.csproj" />
    <ProjectReference Include="../shared/Shared.csproj" />
    <!-- WP0.2: co-hosted Orleans silo (plan §1.4/§3.5, ADR-0002). Server brings the codegen SDK
         transitively (Microsoft.Orleans.Sdk) so grains defined in this project get generated
         serializers. ADO.NET clustering/reminders share the lobby's Postgres (Npgsql is already
         referenced transitively via public-lobby-data; Orleans loads it by invariant name). -->
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.3.1" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.3.1" />
    <PackageReference Include="Microsoft.Orleans.Reminders.AdoNet" Version="10.3.1" />
  </ItemGroup>
</Project>
