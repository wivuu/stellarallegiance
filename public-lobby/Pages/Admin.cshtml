@page "/admin"
@model PublicLobby.Pages.AdminModel
@{
    ViewData["Title"] = "Admin — Public Lobby";
}

<div class="mx-auto max-w-3xl space-y-6">
    <section class="space-y-1">
        <h1 class="font-ui text-2xl font-bold text-text-hi">Admin</h1>
        <p class="text-xs text-text-dim">
            Trust level <span class="font-mono text-data">RANKED_RESULTS=@Model.TrustLevel</span>
            @if (Model.TrustLevel == "authenticated")
            {
                <text>&mdash; every verified server's results move the global ladder; the Ranked flag is informational.</text>
            }
            else
            {
                <text>&mdash; only servers flagged Ranked below move the global ladder.</text>
            }
            &middot; unverified listings @(Model.AllowUnverified ? "allowed" : "refused")
        </p>
    </section>

    <section class="space-y-2">
        <h2 class="text-sm font-semibold text-text-2">Game servers</h2>
        @if (Model.Servers.Length == 0)
        {
            <p class="text-sm text-text-dim">No game server has authenticated yet.</p>
        }
        else
        {
            <div class="overflow-x-auto rounded border border-panel-hi">
                <table class="w-full text-sm">
                    <thead class="bg-panel text-left text-xs uppercase tracking-wide text-text-dim">
                        <tr>
                            <th class="px-3 py-2">Server</th>
                            <th class="px-3 py-2">Operator</th>
                            <th class="px-3 py-2">Last listed</th>
                            <th class="px-3 py-2 text-right">Matches</th>
                            <th class="px-3 py-2">Ranked</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Servers)
                        {
                            <tr class="border-t border-panel-hi/60">
                                <td class="px-3 py-2 text-text-hi"><a class="hover:text-accent" href="/servers/@s.Id/history">@s.Name</a></td>
                                <td class="px-3 py-2 text-text-2"><a class="hover:text-text-hi" href="/players/@Uri.EscapeDataString(s.OperatorName)">@s.OperatorName</a></td>
                                <td class="px-3 py-2 font-mono text-xs text-text-dim">@(s.LastListedAt?.ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                                <td class="px-3 py-2 text-right font-mono text-data">@s.Matches</td>
                                <td class="px-3 py-2">
                                    <form method="post" asp-page-handler="Ranked" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="gameServerId" value="@s.Id" />
                                        <input type="hidden" name="ranked" value="@(s.Ranked ? "false" : "true")" />
                                        @if (s.Ranked)
                                        {
                                            <button type="submit" class="rounded border border-accent/40 bg-accent/10 px-2 py-0.5 text-xs text-accent hover:bg-accent/20" title="Click to unrank">Ranked</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="rounded border border-panel-hi bg-panel px-2 py-0.5 text-xs text-text-dim hover:text-text-hi" title="Click to rank">Unranked</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
