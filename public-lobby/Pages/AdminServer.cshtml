@page "/admin/servers/{id:guid}"
@model PublicLobby.Pages.AdminServerModel
@{
    var s = Model.View.Server;
    ViewData["Title"] = $"{s.Name} — Admin";
}

<div class="mx-auto max-w-3xl space-y-6">
    <a href="/admin?tab=servers" class="block text-[13px] text-text-2 hover:text-text-hi">&larr; Admin &middot; Game servers</a>

    <section class="space-y-1.5">
        <h1 class="flex flex-wrap items-center gap-2.5 font-ui text-2xl font-bold text-text-hi">
            @s.Name
            @if (s.Ranked)
            {
                <span class="rounded border border-accent/40 bg-accent/10 px-2 py-px text-xs font-medium text-accent">Ranked</span>
            }
            @if (Model.Banned)
            {
                <span class="rounded border border-danger/40 bg-danger/10 px-2 py-px text-xs font-medium text-danger">Banned</span>
            }
            <span class="rounded border border-ok/35 px-2 py-px text-xs font-semibold uppercase tracking-[1px] text-ok">Verified</span>
        </h1>
        <p class="text-xs text-text-dim">
            <span class="font-mono">@s.Id</span>
            @if (Model.View.OperatorPlayerId is { } operatorId)
            {
                <span>&middot; operator <a class="text-text-2 hover:text-accent" href="/admin/players/@operatorId">@Model.View.OperatorName</a></span>
                @if (Model.OperatorBanned)
                {
                    <span class="text-danger">(banned)</span>
                }
            }
            else
            {
                <span class="text-warn">&middot; no operator</span>
            }
            &middot; registered @s.CreatedAt.ToString("yyyy-MM-dd")
            &middot; <a class="text-text-2 hover:text-accent" href="/servers/@s.Id/history">public match history</a>
        </p>
    </section>

    @if (Model.Banned)
    {
        <section class="flex items-start justify-between gap-4 rounded border border-danger/40 bg-danger/10 px-3.5 py-3">
            <div class="space-y-0.5">
                <span class="block text-sm font-semibold text-danger">Banned @Model.BanBannerWindow</span>
                <span class="block text-[13px] leading-relaxed text-text-2">
                    @Model.BanReasonShown &mdash; by @Model.Ban!.ByDisplayName, @Model.Ban!.At.ToString("yyyy-MM-dd HH:mm") UTC
                    &middot; listings and results are refused
                </span>
            </div>
            <form method="post" asp-page-handler="Unban" class="shrink-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@s.Id" />
                <button type="submit" class="rounded border border-panel-hi bg-panel px-3 py-1.5 text-[13px] text-text-2 hover:border-accent hover:text-text-hi">Lift ban</button>
            </form>
        </section>
    }

    <section class="space-y-2">
        <div class="flex items-baseline justify-between">
            <h2 class="text-sm font-semibold text-text-2">Current listing</h2>
            @if (Model.Listed)
            {
                <form method="post" asp-page-handler="DropListing">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@s.Id" />
                    <button type="submit" class="rounded border border-panel-hi bg-panel px-2.5 py-1 text-xs text-text-2 hover:border-accent hover:text-text-hi">Drop listing</button>
                </form>
            }
        </div>
        @if (Model.Listed)
        {
            <div class="grid grid-cols-2 gap-3.5 rounded border border-panel-hi bg-panel-fill p-3.5 sm:grid-cols-4">
                @foreach (var f in Model.ListingFacts)
                {
                    <div class="flex flex-col gap-0.5">
                        <span class="text-[10px] font-semibold uppercase tracking-[2px] text-text-dim">@f.Label</span>
                        <span class="truncate font-mono text-[13px] @f.Css" title="@f.Value">@f.Value</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="rounded border border-panel-hi bg-panel px-4 py-3 text-sm text-text-2">
                Not listed. The server keeps its identity, operator and match record; it reappears here the moment it registers again.
            </p>
        }
    </section>

    @if (Model.View.OperatorPlayerId is null)
    {
        <section class="space-y-2.5 rounded border border-warn/30 bg-warn/[0.06] p-4">
            <div class="space-y-0.5">
                <span class="block text-sm font-semibold text-warn">This game server has no operator</span>
                <span class="block text-[13px] leading-relaxed text-text-2">
                    The player who ran it was deleted. It keeps its id and its match record &mdash; every match it
                    reported points at that id &mdash; but it is refused a listing until somebody answers for it.
                </span>
            </div>
            <form method="post" asp-page-handler="Reassign" class="flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@s.Id" />
                <input name="displayName" autocomplete="off" spellcheck="false" placeholder="Display name of the new operator" aria-label="Display name of the new operator"
                       class="flex-1 rounded border border-panel-hi bg-panel px-3 py-2 text-sm text-text-hi placeholder:text-text-dim focus:border-accent focus:outline-none" />
                <button type="submit" class="rounded bg-accent px-4 py-2 text-sm font-semibold text-void hover:bg-accent/90">Reassign</button>
            </form>
            @if (Model.ReassignError is { } reassignError)
            {
                <p class="text-[13px] text-danger">@reassignError</p>
            }
        </section>
    }

    <section class="space-y-2">
        <h2 class="text-sm font-semibold text-text-2">Ranked standing</h2>
        <div class="flex items-center justify-between gap-5 rounded border border-panel-hi bg-panel p-3.5">
            <div class="space-y-0.5">
                <span class="block text-sm font-semibold text-text-hi">@Model.RankedPanel.Title</span>
                <span class="block text-[13px] leading-relaxed text-text-2">@Model.RankedPanel.Blurb</span>
            </div>
            <form method="post" asp-page-handler="Ranked" class="shrink-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@s.Id" />
                <input type="hidden" name="ranked" value="@(Model.RankedPanel.Rank ? "true" : "false")" />
                <button type="submit" class="rounded border px-3.5 py-1.5 text-[13px] font-medium @(Model.RankedPanel.Rank ? "border-accent/40 bg-accent/10 text-accent hover:bg-accent/20" : "border-panel-hi bg-panel text-text-2 hover:border-accent hover:text-text-hi")">@Model.RankedPanel.Button</button>
            </form>
        </div>
    </section>

    <section class="space-y-2">
        <div class="flex items-baseline justify-between">
            <h2 class="text-sm font-semibold text-text-2">Recent matches</h2>
            <span class="text-xs text-text-dim"><span class="font-mono text-data">@Model.View.TotalMatches.ToString("N0")</span> reported in total</span>
        </div>
        @if (Model.View.Recent.Length == 0)
        {
            <p class="text-sm text-text-dim">No matches reported yet.</p>
        }
        else
        {
            <div class="overflow-x-auto rounded border border-panel-hi">
                <table class="w-full text-sm">
                    <thead class="bg-panel text-left text-xs uppercase tracking-wide text-text-dim">
                        <tr>
                            <th class="px-3 py-2">Started</th>
                            <th class="px-3 py-2">Map</th>
                            <th class="px-3 py-2">Outcome</th>
                            <th class="w-[62px] px-3 py-2 text-right">Pilots</th>
                            <th class="w-[96px] px-3 py-2">Standing</th>
                        </tr>
                    </thead>
                    <tbody class="font-mono text-data">
                        @foreach (var m in Model.View.Recent)
                        {
                            var outcome = Model.Outcome(m);
                            var standing = Model.Standing(m);
                            <tr class="border-t border-panel-hi/60 hover:bg-panel">
                                <td class="px-3 py-2 text-xs text-text-dim">@m.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-3 py-2 font-ui"><a class="text-text-hi hover:text-accent" href="/admin/matches/@m.MatchId">@m.Map</a></td>
                                <td class="px-3 py-2 font-ui text-[13px] @outcome.Css">@outcome.Label</td>
                                <td class="px-3 py-2 text-right">@m.Pilots</td>
                                <td class="px-3 py-2 font-ui text-xs @standing.Css">@standing.Label</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="space-y-3 rounded border border-danger/30 p-4">
        <h2 class="text-sm font-semibold uppercase tracking-[1px] text-danger">Danger zone</h2>
        <div class="flex items-center justify-between gap-5">
            <div class="space-y-0.5">
                <span class="block text-sm font-semibold text-text-hi">@Model.BanPanel.Title</span>
                <span class="block text-[13px] leading-relaxed text-text-2">@Model.BanPanel.Blurb</span>
            </div>
            @if (Model.Banned)
            {
                <form method="post" asp-page-handler="Unban" class="shrink-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@s.Id" />
                    <button type="submit" class="rounded border border-danger/40 bg-danger/10 px-3.5 py-1.5 text-[13px] font-medium text-danger hover:bg-danger/20">@Model.BanPanel.Button</button>
                </form>
            }
            else
            {
                <a href="/admin/servers/@s.Id?ban=true" class="shrink-0 rounded border border-danger/40 bg-danger/10 px-3.5 py-1.5 text-[13px] font-medium text-danger hover:bg-danger/20">@Model.BanPanel.Button</a>
            }
        </div>
        <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-3 border-t border-danger/20 pt-3">
            <div class="space-y-0.5">
                <span class="block text-sm font-semibold text-text-hi">@Model.DeletePanel.Title</span>
                <span class="block text-[13px] leading-relaxed text-text-2">@Model.DeletePanel.Blurb</span>
            </div>
            <a href="/admin/servers/@s.Id?confirm=delete" class="shrink-0 rounded border border-danger/40 bg-danger/10 px-3.5 py-1.5 text-[13px] font-medium text-danger hover:bg-danger/20">Delete&hellip;</a>
        </div>
        <p class="text-xs leading-relaxed text-text-dim">@Model.DeleteLadderNote</p>
    </section>
</div>

@if (Model.ShowBanDialog && !Model.Banned)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-void/[0.78] p-6">
        <form method="post" asp-page-handler="Ban" class="flex w-[470px] flex-col gap-3.5 rounded border border-panel-hi bg-panel p-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@s.Id" />
            <div class="space-y-1.5">
                <h3 class="text-[17px] font-bold text-text-hi">Ban game server &ldquo;@s.Name&rdquo;</h3>
                <p class="text-[13px] leading-relaxed text-text-2">@Model.BanDialogBody</p>
            </div>
            <div class="space-y-1.5">
                <label for="ban-reason" class="block text-xs font-semibold uppercase tracking-[1px] text-text-dim">Reason (recorded, shown to the operator)</label>
                <input id="ban-reason" name="reason" autocomplete="off" maxlength="200" placeholder="e.g. reporting results for matches that were never played"
                       class="w-full rounded border border-panel-hi bg-panel-deep px-3 py-2 text-sm text-text-hi placeholder:text-text-dim focus:border-accent focus:outline-none" />
            </div>
            <fieldset class="space-y-1.5">
                <legend class="text-xs font-semibold uppercase tracking-[1px] text-text-dim">Duration</legend>
                <div class="flex gap-1.5">
                    @foreach (var d in AdminModeration.Durations)
                    {
                        <label class="flex-1 cursor-pointer rounded border border-panel-hi bg-panel-deep py-1.5 text-center text-[13px] font-medium text-text-2 has-checked:border-danger/40 has-checked:bg-danger/10 has-checked:text-danger">
                            <input type="radio" name="duration" value="@d.Id" class="sr-only" checked="@(d.Id == AdminModeration.DefaultDuration)" />
                            @d.Label
                        </label>
                    }
                </div>
            </fieldset>
            <label class="flex cursor-pointer items-center gap-2.5 rounded border border-panel-hi bg-panel-deep px-3 py-2.5 has-checked:border-danger/40 has-checked:bg-danger/[0.08]">
                <input type="checkbox" name="alsoUnrank" value="true" checked class="size-3.5 accent-danger" />
                <span class="text-[13px] text-text-hi">Drop its Ranked flag as well</span>
            </label>
            <p class="border-l-2 border-warn/50 pl-2.5 text-xs leading-relaxed text-text-dim">@Model.BanDialogEffect</p>
            <div class="flex items-center justify-end gap-2.5 pt-0.5">
                <a href="/admin/servers/@s.Id" class="px-3 py-2 text-sm text-text-2 hover:text-text-hi">Cancel</a>
                <button type="submit" class="rounded bg-danger px-4 py-2 text-sm font-semibold text-void hover:bg-danger/85">Ban server</button>
            </div>
        </form>
    </div>
}

@if (Model.ShowDeleteDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-void/[0.82] p-6">
        <div class="bracket-frame w-full max-w-[520px] p-1">
            <form method="post" asp-page-handler="Delete" class="flex flex-col gap-3.5 border border-danger/30 bg-panel p-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@s.Id" />

                <div class="space-y-1.5">
                    <h3 class="text-[17px] font-bold text-text-hi">Delete game server &ldquo;@s.Name&rdquo;</h3>
                    <p class="text-[13px] leading-relaxed text-text-2">
                        There is no undo and no grace period &mdash; if you only want it off the browser for a
                        while, ban it instead.
                    </p>
                </div>

                <div class="space-y-1.5">
                    <span class="block text-xs font-semibold uppercase tracking-[1px] text-text-dim">Erased immediately</span>
                    @foreach (var line in Model.DeleteErased)
                    {
                        <span class="flex items-start gap-2 text-[13px] leading-relaxed text-text-hi">
                            <span class="text-danger">&minus;</span>@line
                        </span>
                    }
                </div>

                <p class="border-l-2 border-warn/50 pl-2.5 text-xs leading-relaxed text-text-dim">@Model.DeleteLadderNote</p>

                <div class="space-y-1.5">
                    <label for="confirm-server-name" class="block text-xs font-semibold uppercase tracking-[1px] text-text-dim">
                        Type <span class="font-mono text-danger">@s.Name</span> to confirm
                    </label>
                    <input id="confirm-server-name" name="confirmName" autocomplete="off" spellcheck="false" placeholder="Server name"
                           class="w-full rounded border border-panel-hi bg-panel-deep px-3 py-2 font-mono text-sm text-text-hi placeholder:text-text-dim focus:border-accent focus:outline-none" />
                    @if (Model.DeleteError is { } deleteError)
                    {
                        <p class="text-[13px] text-danger">@deleteError</p>
                    }
                </div>

                <div class="flex items-center justify-end gap-2.5 pt-0.5">
                    <a href="/admin/servers/@s.Id" class="px-3 py-2 text-sm text-text-2 hover:text-text-hi">Cancel</a>
                    <button type="submit" class="rounded bg-danger px-4 py-2 text-sm font-semibold text-void hover:bg-danger/85">Delete permanently</button>
                </div>
            </form>
        </div>
    </div>
}
