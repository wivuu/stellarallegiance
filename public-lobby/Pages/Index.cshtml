@page "/"
@model PublicLobby.Pages.IndexModel
@{
    ViewData["Title"] = "Stellar Allegiance — Public Lobby";
    const string Repo = "https://github.com/onionhammer/wivuullegiance";

    // Head of the ladder gets a little hierarchy the paginated /ladder table doesn't need.
    string RankClass(int rank) => rank == 1 ? "text-accent" : rank <= 3 ? "text-text-2" : "text-text-dim";
}

<div class="space-y-0">

    @* ---- Hero ------------------------------------------------------------------------------ *@
    <section class="flex items-center gap-10 pt-8 pb-11">
        <img src="/logo.png" alt="Stellar Allegiance" width="240" class="w-60 shrink-0" />
        <div class="flex flex-col gap-[18px]">
            <div class="flex items-center gap-2.5">
                <span class="size-2.5 rotate-45 bg-accent"></span>
                <span class="text-[13px] font-medium uppercase tracking-[2px] text-text-2">Public Lobby</span>
            </div>
            <h1 class="text-[34px] font-bold leading-[1.15] text-text-hi text-balance">An ancient game,<br />reimagined</h1>
            <p class="text-[15px] leading-[1.65] text-text-2 text-pretty">
                A 3D multiplayer space-combat game &mdash; a Godot client predicting flight against an
                authoritative 20&nbsp;Hz .NET sim server. Mine, research, build stations and take the
                enemy's home base, with one player commanding from the map.
            </p>
            <div class="flex items-center gap-3 pt-1">
                <a href="@Repo" class="chamfer flex items-center gap-2 bg-accent px-3.5 py-[11px] text-sm font-semibold tracking-[0.02em] text-void hover:bg-accent/85">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M8 6 3 12l5 6"></path><path d="m16 6 5 6-5 6"></path></svg>
                    View on GitHub
                </a>
                <a href="/ladder" class="chamfer flex items-center gap-2 border border-hairline-hi/40 bg-accent/10 px-3.5 py-2.5 text-sm font-medium text-text-hi hover:bg-accent/20">Browse the ladder</a>
            </div>
        </div>
    </section>

    @* ---- Honest-prototype note (README's CAUTION) -------------------------------------------- *@
    <div class="flex gap-3 rounded border border-warn/30 bg-warn/6 px-3.5 py-3">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffb347" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-px shrink-0" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path></svg>
        <p class="text-sm leading-relaxed text-text-2">
            <strong class="font-semibold text-warn">Functional prototype.</strong>
            Written by Claude under supervision &mdash; expect bugs and rough edges. It exists to show
            that Allegiance can be re-platformed as a modern cross-platform game.
        </p>
    </div>

    <div class="flex items-center gap-3 py-10">
        <span class="h-px flex-1 bg-hairline"></span>
        <span class="size-2.5 shrink-0 rotate-45 bg-accent"></span>
        <span class="h-px flex-1 bg-hairline"></span>
    </div>

    @* ---- Servers online --------------------------------------------------------------------- *@
    <section class="flex flex-col gap-3">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-[22px] font-bold text-text-hi">Servers online</h2>
            <span class="font-mono text-[13px] text-text-dim">
                @Model.ServersOnline listed &middot; @Model.PilotsOnline @(Model.PilotsOnline == 1 ? "pilot" : "pilots")
            </span>
        </div>
        <p class="text-sm leading-relaxed text-text-dim">
            Anyone can host. A listing goes <span class="text-ok">Verified</span> once its game server
            authenticates with the lobby &mdash; only Verified servers issue join tokens and report
            results to the ladder.
        </p>

        @if (Model.Servers.Count == 0)
        {
            <p class="mt-1 rounded border border-panel-hi bg-panel px-4 py-3 text-sm text-text-2">
                No servers listed right now. Start one and it appears here automatically.
            </p>
        }
        else
        {
            <div class="mt-1 overflow-hidden rounded border border-panel-hi">
                @foreach (var (server, i) in Model.Servers.Select((s, i) => (s, i)))
                {
                    var badge = PublicLobby.Pages.IndexModel.StateBadge(server.State);
                    <div class="flex items-center justify-between gap-4 px-3.5 py-3 @(i == 0 ? "bg-panel/50" : "border-t border-panel-hi/60")">
                        <div class="flex min-w-0 flex-col gap-[5px]">
                            <div class="flex items-center gap-2">
                                <span class="truncate text-[15px] font-semibold text-text-hi">@server.Name</span>
                                @if (server.Verified)
                                {
                                    <span class="shrink-0 rounded-sm border border-ok/35 px-1.5 py-px text-xs font-semibold uppercase tracking-[1px] text-ok">Verified</span>
                                }
                                else
                                {
                                    <span class="shrink-0 rounded-sm border border-hairline px-1.5 py-px text-xs font-semibold uppercase tracking-[1px] text-text-dim">Unverified</span>
                                }
                                @if (server.Protected)
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#ffb347" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><title>Password required</title><rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                }
                            </div>
                            @if (server.Verified && !string.IsNullOrWhiteSpace(server.OperatorName))
                            {
                                <span class="text-[13px] text-text-dim">hosted by <span class="text-text-2">@server.OperatorName</span></span>
                            }
                            else
                            {
                                <span class="text-[13px] text-text-dim">no operator &middot; direct join only</span>
                            }
                        </div>
                        <div class="flex shrink-0 items-center gap-3.5">
                            <span class="text-xs font-semibold uppercase tracking-[1px] @badge.Css">@badge.Label</span>
                            <span class="font-mono text-sm text-data">@server.Players/@server.MaxPlayers</span>
                        </div>
                    </div>
                }
            </div>
            @if (Model.ServersOnline > Model.Servers.Count)
            {
                <p class="text-[13px] text-text-dim">
                    @(Model.ServersOnline - Model.Servers.Count) more listed &mdash; sign in and open the server browser in the client to see them all.
                </p>
            }
        }
    </section>

    <div class="flex items-center gap-3 py-10">
        <span class="h-px flex-1 bg-hairline"></span>
        <span class="size-2.5 shrink-0 rotate-45 bg-accent"></span>
        <span class="h-px flex-1 bg-hairline"></span>
    </div>

    @* ---- Top of the ladder ------------------------------------------------------------------ *@
    <section class="flex flex-col gap-3">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-[22px] font-bold text-text-hi">Top pilots</h2>
            <a href="/ladder" class="text-sm text-data hover:text-text-hi">Full ladder &rarr;</a>
        </div>
        <p class="text-sm leading-relaxed text-text-dim">
            Cumulative standings from ranked matches. Every pilot on the ledger gets the match with
            their team's outcome.
        </p>

        @if (Model.Ladder.Total == 0)
        {
            <p class="mt-1 rounded border border-panel-hi bg-panel px-4 py-3 text-sm text-text-2">
                No ranked matches recorded yet.
            </p>
        }
        else
        {
            <div class="bracket-frame mt-1">
                <div class="overflow-x-auto rounded border border-panel-hi">
                    <table class="w-full text-sm">
                        <thead class="bg-panel text-left text-xs uppercase tracking-wide text-text-dim">
                            <tr>
                                <th class="w-11 px-3 py-2">#</th>
                                <th class="px-3 py-2">Player</th>
                                <th class="w-[58px] px-3 py-2 text-right">Pts</th>
                                <th class="w-11 px-3 py-2 text-right">W</th>
                                <th class="w-11 px-3 py-2 text-right">L</th>
                                <th class="w-12 px-3 py-2 text-right">K</th>
                                <th class="w-12 px-3 py-2 text-right">D</th>
                                <th class="w-12 px-3 py-2 text-right">EJ</th>
                                <th class="w-[76px] px-3 py-2 text-right">Matches</th>
                            </tr>
                        </thead>
                        <tbody class="font-mono text-data">
                            @foreach (var row in Model.Ladder.Rows)
                            {
                                <tr class="border-t border-panel-hi/60 first:border-t-0 hover:bg-panel">
                                    <td class="px-3 py-2 @RankClass(row.Rank)">@row.Rank</td>
                                    <td class="px-3 py-2 font-ui text-text-hi"><a class="hover:text-accent" href="/players/@Uri.EscapeDataString(row.DisplayName)">@row.DisplayName</a></td>
                                    <td class="px-3 py-2 text-right">@row.Points</td>
                                    <td class="px-3 py-2 text-right text-ok">@row.Wins</td>
                                    <td class="px-3 py-2 text-right text-danger">@row.Losses</td>
                                    <td class="px-3 py-2 text-right">@row.Kills</td>
                                    <td class="px-3 py-2 text-right">@row.Deaths</td>
                                    <td class="px-3 py-2 text-right">@row.Ejects</td>
                                    <td class="px-3 py-2 text-right">@row.MatchesPlayed</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <div class="flex items-center gap-3 py-10">
        <span class="h-px flex-1 bg-hairline"></span>
        <span class="size-2.5 shrink-0 rotate-45 bg-accent"></span>
        <span class="h-px flex-1 bg-hairline"></span>
    </div>

    @* ---- Get in the cockpit ----------------------------------------------------------------- *@
    <section class="flex flex-col gap-3 pb-6">
        <h2 class="text-[22px] font-bold text-text-hi">Get in the cockpit</h2>
        <p class="text-sm leading-relaxed text-text-dim">
            No installer yet &mdash; you build it from source. You'll need the .NET&nbsp;10 SDK,
            Godot&nbsp;4.7 (Mono/.NET build) and PowerShell&nbsp;7+.
        </p>

        <div class="mt-2 grid grid-cols-3 gap-4">
            <div class="flex flex-col gap-2 rounded border border-hairline bg-panel-fill p-3.5">
                <span class="font-mono text-xs text-accent">01</span>
                <h3 class="text-[15px] font-semibold text-text-hi">Clone and build</h3>
                <p class="text-[13px] leading-relaxed text-text-2">Pull the repo and let the toolchain restore. The physics core is shared by client and server, so both stay bit-identical.</p>
            </div>
            <div class="flex flex-col gap-2 rounded border border-hairline bg-panel-fill p-3.5">
                <span class="font-mono text-xs text-accent">02</span>
                <h3 class="text-[15px] font-semibold text-text-hi">Launch the client</h3>
                <p class="text-[13px] leading-relaxed text-text-2">Run <code class="font-mono text-xs text-data">scripts/run-client.ps1</code> and it opens the server browser against this lobby.</p>
            </div>
            <div class="flex flex-col gap-2 rounded border border-hairline bg-panel-fill p-3.5">
                <span class="font-mono text-xs text-accent">03</span>
                <h3 class="text-[15px] font-semibold text-text-hi">Sign in and fly</h3>
                <p class="text-[13px] leading-relaxed text-text-2">Approve the device code in your browser, pick a Verified server, ready up. Or join any address directly.</p>
            </div>
        </div>

        <div class="mt-3 flex flex-col gap-2.5 rounded border border-panel-hi bg-panel-deep p-3.5">
            <div class="flex items-center gap-2">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7fa6c8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2"></rect><rect width="20" height="8" x="2" y="14" rx="2"></rect><path d="M6 6h.01"></path><path d="M6 18h.01"></path></svg>
                <span class="text-[13px] font-medium uppercase tracking-[2px] text-text-2">Host a server</span>
            </div>
            <p class="text-[13px] leading-relaxed text-text-dim">Prebuilt images are on GHCR &mdash; forward the port and your server lists itself here automatically.</p>
            <code class="block overflow-x-auto whitespace-pre rounded-sm border border-hairline bg-void px-3 py-2.5 font-mono text-[12.5px] leading-[1.7] text-data">docker run --rm -p 8090:8090 \
  -e SIM_PUBLIC_NAME="My Server" \
  ghcr.io/wivuu/stellarallegiance-sim:latest</code>
        </div>
    </section>

</div>
