@page "/login"
@model PublicLobby.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in — Public Lobby";
}

<div class="mx-auto max-w-sm space-y-8">
    <h1 class="font-ui text-2xl font-bold text-text-hi text-center">Sign in</h1>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="rounded border border-danger/40 bg-danger/10 px-3 py-2 text-sm text-danger">@Model.Error</p>
    }

    @if (Model.Providers.Count > 0)
    {
        <section class="space-y-2">
            @foreach (var provider in Model.Providers)
            {
                <a
                    href="/login/external?provider=@Uri.EscapeDataString(provider.Scheme)&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")"
                    class="block w-full rounded border border-panel-hi bg-panel px-4 py-2 text-center text-sm font-medium text-text-hi hover:border-accent hover:text-accent">
                    Continue with @provider.DisplayName
                </a>
            }
        </section>
        <div class="flex items-center gap-3 text-xs text-text-dim">
            <span class="h-px flex-1 bg-panel-hi"></span>
            <span>or</span>
            <span class="h-px flex-1 bg-panel-hi"></span>
        </div>
    }

    <section class="space-y-3">
        <button
            id="passkey-signin"
            type="button"
            class="block w-full rounded border border-accent bg-accent/10 px-4 py-2 text-center text-sm font-medium text-accent hover:bg-accent/20">
            Sign in with a passkey
        </button>
        <p id="passkey-unavailable" hidden class="text-center text-xs text-warn">
            Passkeys aren't available in this browser. Try Chrome, Safari, or Edge, or use another sign-in
            option above.
        </p>
    </section>

    <section class="space-y-2 rounded border border-panel-hi bg-panel p-4">
        <h2 class="text-sm font-semibold text-text-2">New here? Create a passkey</h2>
        <form id="passkey-signup" class="space-y-2">
            <label class="block text-xs text-text-dim" for="signup-display-name">Display name</label>
            <input
                id="signup-display-name"
                name="displayName"
                type="text"
                required
                minlength="3"
                maxlength="24"
                autocomplete="username webauthn"
                placeholder="Vex"
                class="w-full rounded border border-panel-hi bg-void px-3 py-2 text-sm text-text-hi placeholder:text-text-dim focus:border-accent focus:outline-none" />
            <button
                type="submit"
                class="block w-full rounded border border-secondary bg-secondary/10 px-4 py-2 text-center text-sm font-medium text-secondary hover:bg-secondary/20">
                Create passkey
            </button>
        </form>
    </section>

    <p id="passkey-status" class="text-center text-sm text-text-2" role="status"></p>
</div>

<input type="hidden" id="login-return-url" value="@Model.ReturnUrl" />
<script src="/passkeys.js"></script>
