<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same seam as LoadoutTest: SimServer brings Simulation/World/ContentLoader/Protocol; the
         shared def records come transitively. TestKit brings the in-memory hub harness the
         ride-along sections drive. Neither Main is ever invoked. -->
    <ProjectReference Include="../../shared/Shared.csproj" />
    <ProjectReference Include="../../server/SimServer.csproj" />
    <ProjectReference Include="../TestKit/TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stock bundle under test, copied next to the test binary (mirrors LoadoutTest). -->
    <Content
      Include="../../server/content/core/**/*.yaml"
      Link="content/core/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
