<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same seam as FuelPodTest/CommanderTest: SimServer brings Simulation/World/ContentLoader/Frames
         (plus, transitively, the base GLBs the docking scenarios need); the shared def records and
         the ShipResources rule come with it. Its Main is never invoked. -->
    <ProjectReference Include="../../shared/Shared.csproj" />
    <ProjectReference Include="../../server/SimServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stock bundle under test, copied next to the test binary (mirrors FuelPodTest). -->
    <Content
      Include="../../server/content/core/**/*.yaml"
      Link="content/core/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
