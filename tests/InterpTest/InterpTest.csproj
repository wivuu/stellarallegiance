<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real shared flight model + wire quantizers: trajectories are generated by the same
         Integrate the server runs and pushed through the same PackPos/PackQuat/PackHalf the wire uses. -->
    <ProjectReference Include="../../shared/Shared.csproj" />
    <!-- GodotSharp's managed math types (Vector3/Quaternion/Mathf) are plain structs that need no
         engine; this lets the suite compile the client's interpolator UNMODIFIED, headless.

         PINNED to 4.7.2 to match the client's `Godot.NET.Sdk/4.7.2`, the GODOT_VERSION the release
         workflow installs, and the 4.7.2 editor/export templates. The
         Compile Include list below pulls in the PRODUCTION interpolator, so the suite is only
         honest while its Vector3/Quaternion/Mathf are the ones that actually ship. Never bump this
         on its own because `dotnet outdated` offers a newer GodotSharp: that would silently test
         the client against a different math library than the game runs. Move it only together with
         the client SDK, the workflows and the installed engine.

         It is a VersionOverride, not a Directory.Packages.props entry, because Godot.NET.Sdk
         defines GodotSharp IMPLICITLY for the client and CPM rejects a central version for an
         implicit reference (NU1009). -->
    <PackageReference Include="GodotSharp" VersionOverride="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the production remote-motion sources so the numbers here are the numbers in-game. -->
    <Compile Include="../../client/scripts/MotionInterpolator.cs" Link="client/MotionInterpolator.cs" />
    <Compile Include="../../client/scripts/InterpStats.cs" Link="client/InterpStats.cs" />
    <Compile Include="../../client/scripts/world/MatchClock.cs" Link="client/MatchClock.cs" />
    <Compile Include="../../client/scripts/world/ITickSource.cs" Link="client/ITickSource.cs" />
  </ItemGroup>
</Project>
