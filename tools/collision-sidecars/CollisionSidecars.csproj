<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the client's COLLISION SIDECARS: one <name>.glb.simmodel beside every base / ship /
       asteroid GLB under client/assets, holding the built collision model (shared SimModelCodec).
       A packaged client has no raw .glb to build from - Godot's exporter ships an imported GLB as its
       imported scene only - so these files are the collision data of every release. Run by
       scripts/package-clients.ps1 and scripts/export-clients.ps1 right before the Godot export:

           dotnet run -c Release - -project tools/collision-sidecars - - client/assets

       References ONLY shared/: the model is built by the very code the server and the client compile
       (GlbReader + ConvexHull.Build), so what ships is bit-identical to what the server resolves. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/Shared.csproj" />
  </ItemGroup>
</Project>
