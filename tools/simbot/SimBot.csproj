<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless bot swarm for load-testing the Phase-1 sim server: N WebSocket clients
       that join, fly, and fire at full input rate (worst case — real clients send on
       change). Usage: dotnet run - -bots 200 [- -url ws://localhost:8090/game] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared wire frames (shared/Net/Messages.cs): the bot speaks the exact layouts the
         server and client compile, so a protocol change is a rebuild here, never a hand edit. -->
    <ProjectReference Include="../../shared/Shared.csproj" />
  </ItemGroup>
</Project>
