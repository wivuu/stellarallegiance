<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Phase-1 native sim server (see ~/.claude plan replicated-purring-duckling / HANDOFF):
       owns the 20 Hz authoritative match simulation in plain process memory and streams
       AOI-filtered binary snapshots over WebSocket. SpacetimeDB has since been removed
       entirely (the server is standalone); join tokens are now short-lived ES256 JWTs
       minted by the public lobby and verified here offline (see public-lobby/CONTEXT.md).
       References the same shared deterministic FlightModel the module and Godot client
       compile, so prediction math stays bit-identical across all three. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Latency-sensitive 20 Hz sim thread + parallel snapshot fan-out: server GC gives a
         per-core heap so the parallel AfterStep doesn't contend on one allocator, concurrent
         GC keeps collections off the tick thread (trims the step-time p99 jitter), and PGO
         lets the steady-state hot path (snapshot build) re-optimize after warmup. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Emit the .xml doc file so the gen-schemas command can surface WorldDef/MapDef summary
         comments as schema description fields. CS1591 (missing XML comment for a public member)
         is silenced so undocumented members don't spam warnings. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- `dotnet publish -r <rid>` produces a NativeAOT binary: a single self-contained executable
         with no JIT - the first sim tick runs at full speed (no tiered-compilation warm-up on the
         20 Hz thread), it boots in milliseconds and the container needs no .NET runtime (see
         Dockerfile). `dotnet run` / `dotnet build` / the test suites stay on the JIT, which is
         also where the settings above (TieredPGO) still apply. Opt out with -p:PublishAot=false
         for a framework-dependent publish. Needs the platform's native toolchain (clang + zlib
         headers on Linux, Xcode CLT on macOS, the C++ workload on Windows).

         What this costs: no runtime reflection over our own types. JSON goes through the
         source-generated contexts in Net/ServerJson.cs, YAML through the static contexts
         (Content/ServerYaml.cs + the factions library), and the gen-schemas command (reflection
         tooling) runs from source only. The IL warnings below are exactly "this will break in the
         native binary", so they fail the build - a normal `dotnet build` too, because PublishAot
         turns the analyzers on. -->
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <!-- PublishAot also applies the trimmed-app feature defaults to ORDINARY builds (dev runs mimic the
         native feature set on purpose: no reflection JSON, no dynamic code). Two of those defaults
         only hurt the inner loop, so Debug keeps them: without startup hooks `dotnet watch` and the
         IDE cannot attach Hot Reload ("Project does not support Hot Reload: 'PublishAot' is 'True'"). -->
    <StartupHookSupport Condition="'$(Configuration)' == 'Debug'">true</StartupHookSupport>
    <MetadataUpdaterSupport Condition="'$(Configuration)' == 'Debug'">true</MetadataUpdaterSupport>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- YDNG001: a YAML-bound property whose type is missing from ServerYamlContext. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050;YDNG001</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Third-party reflection the trimmer cannot see (today: SIPSorcery's SCTP cookie). -->
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>
  <!-- Settings that must exist ONLY in the native link, so they hook the link pipeline instead of
       sitting in an ItemGroup (where they would also leak into the JIT build's runtimeconfig.json).

       1. SimServer.SchemaTooling.IsSupported=false: Program.cs guards the reflection-only gen-schemas
          command with that feature switch. Given the value here, the AOT compiler folds the guard to
          false and drops the branch (without it the publish fails on IL2026/IL3050 - it cannot be
          forgotten silently); `dotnet run` never sees the item, so the command works from source.

       2. The IL errors above are for OUR code. These dependencies carry trim warnings of their own
          that were checked by hand, so collapse each to the single IL2104 "assembly produced trim
          warnings" line (kept visible, not an error) instead of failing the publish:
            SIPSorcery        - its bundled TinyJson reflection helper. The one use on our path is the
                                SCTP cookie, rooted in TrimmerRoots.xml; the rest is signaling-helper
                                JSON the server never calls (it builds its own SDP, see
                                shared/Net/WebRtcSdp.cs).
            Common.Logging(*) - Makaretu mDNS logging: reflection only for a CONFIGURED log adapter;
                                with no config it falls back to the no-op adapter.
          A NEW warning from any other assembly still breaks the publish. -->
  <Target Name="ConfigureNativeLink" BeforeTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="SimServer.SchemaTooling.IsSupported" Value="false" Trim="true" />
      <ManagedAssemblyToLink
        Condition="'%(Filename)' == 'SIPSorcery' Or '%(Filename)' == 'Common.Logging' Or '%(Filename)' == 'Common.Logging.Core'"
      >
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Ship the art GLBs the sim reads for collision hulls + docking hardpoints NEXT TO the
         binary (output/assets/...), so a plain `dotnet publish` is a self-contained server
         distribution — not Docker-only. Source of truth stays client/assets/ (the Godot client's
         copy); these are linked, not duplicated. The server resolves them via AppContext at run
         time (SimAssets) and bakes per-model convex hulls into a sibling sim-cache/ on first use. -->
    <Content
      Include="..\client\assets\bases\*.glb"
      Link="assets\bases\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\client\assets\asteroids\*.glb"
      Link="assets\asteroids\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\client\assets\ships\*.glb"
      Link="assets\ships\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!-- Stage-1 content pipeline (canonical Allegiance.Factions format): ship the AUTHORITATIVE
         content bundle next to the binary, preserving the manifest/catalog layout. The
         server loads content/core/core.manifest.yaml at boot (content is YAML, never hardcoded);
         the content/CONTENT_PATH override points at a different bundle manifest. -->
    <Content
      Include="Content\core\**\*.yaml"
      Link="content\core\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!-- Stock MAPS: standalone map files (separate from the faction/tech-tree bundle), shipped next
         to the binary at content/maps/. Operators extend the set via SIM_MAPS_DIR (or the maps-dir
         CLI flag). -->
    <Content
      Include="Content\maps\**\*.yaml"
      Link="content\maps\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../shared/Shared.csproj" />
    <!-- Stage-1 PIVOT: the in-repo Allegiance.Factions library is the canonical content model
         (factions/tech tree/ship catalog). Server-only — it pulls YamlDotNet (already referenced
         here), and its output projects to the existing shared/ def records, so shared/client/wasm
         never reference it. See .PLAN/STAGE-1-2-PHASES.md. -->
    <ProjectReference Include="../factions/src/Allegiance.Factions/Allegiance.Factions.csproj" />
    <!-- Pure-managed WebRTC (DataChannels) for the NAT-traversal transport. The same library
         runs on the Godot client and (optionally) simbot, so the offerer/answerer interop on one
         codebase. WebSocket stays the direct/LAN transport; WebRTC is the public-lobby path. -->
    <PackageReference Include="SIPSorcery" />
    <!-- Stage-1 content pipeline: the server loads per-server YAML content overrides at boot
         (server/Content/ContentLoader). Server-only, so shared/ stays dependency-free and the
         client/wasm never pull YamlDotNet. -->
    <PackageReference Include="YamlDotNet" />
    <!-- YamlDotNet's source generator for ServerYamlContext (Content/ServerYaml.cs). Compile-time
         only; keep the version in lockstep with YamlDotNet. -->
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
    <!-- Join tokens (public-lobby/CONTEXT.md): the lobby-issued ES256 JWT a joiner presents in Hello
         is verified OFFLINE here against the lobby's JWKS (server/Net/JoinTokenVerifier.cs). Server-
         only so shared/ stays dependency-free. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- Non-trickle SDP/ICE helpers shared with the Godot client (excluded from Shared.csproj,
         which is dependency-free); compiled in here so both sides serialize candidates identically. -->
    <Compile Include="../shared/Net/WebRtcSdp.cs" Link="Net/WebRtcSdp.cs" />
  </ItemGroup>
</Project>
