{
    // Running/deploying the game goes through the Aspire CLI (`aspire run`, `aspire resource
    // client launch`) — see the "Aspire: …" tasks below. Run any task with
    //   Cmd/Ctrl+Shift+P → "Tasks: Run Task"
    //
    // The remaining PowerShell tasks (Godot import/export, asteroid-gen) run through
    // PowerShell 7+ (`pwsh`), which must be on PATH (cross-platform: Windows/macOS/Linux). Aspire
    // and the scripts both auto-detect Godot from PATH and standard install locations; to pin a
    // non-standard path per-workstation, run the "Godot: set executable path" task below (stored
    // via `dotnet user-secrets`, outside the repo — never committed). The `godot.executablePath`
    // setting / GODOT env var still take precedence if set.
    "version": "2.0.0",
    "options": {
        "env": { "GODOT": "${config:godot.executablePath}" }
    },
    "tasks": [
        {
            "label": "Godot: import assets (if needed)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/godot-import.ps1"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Godot: reimport assets (force)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/godot-import.ps1",
                "-Force"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Aspire: run",
            "type": "shell",
            "command": "aspire",
            "args": [
                "run"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "run"
            },
            "problemMatcher": []
        },
        {
            "label": "Aspire: launch client",
            "type": "shell",
            "command": "aspire",
            "args": [
                "resource",
                "client",
                "launch",
                "--mode",
                "${input:clientMode}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "run"
            },
            "problemMatcher": []
        },
        {
            "label": "Run server (public lobby)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/run-server.ps1"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "run"
            },
            "problemMatcher": []
        },
        {
            "label": "Run client (public lobby)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/run-client.ps1"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "run"
            },
            "problemMatcher": []
        },
        {
            "label": "Export clients (all platforms)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/scripts/export-clients.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            // Stores your machine's Godot path in the `dotnet user-secrets` store (outside the
            // repo, never committed). scripts/godot-bin.ps1 reads it back when resolving Godot.
            "label": "Godot: set executable path",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "user-secrets",
                "set",
                "godot.executablePath",
                "${input:godotPath}",
                "--id",
                "stellarallegiance"
            ],
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Asteroid-gen: build catalog",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/tools/asteroid-gen/build.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "godotPath",
            "type": "promptString",
            "description": "Full path to the Godot 4 .NET (mono) executable (not a macOS .app folder)"
        },
        {
            "id": "clientMode",
            "type": "pickString",
            "description": "How the launched client should connect",
            "options": [
                "lobby",
                "direct",
                "autofly"
            ],
            "default": "lobby"
        }
    ]
}
